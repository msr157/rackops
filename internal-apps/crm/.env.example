# RackOps Admin — copy to .env and fill in. Only the first two are required.

# Console login.
RACKOPS_ADMIN_EMAIL=ops@rackops.in
RACKOPS_ADMIN_PASSWORD=change-me

# ---- Front Door (the tunnel customers connect to) ----

# DNS zone customer app addresses live under. Needs an A record for
# *.<zone> pointing at this machine.
FRONTDOOR_ZONE=link.rackops.in

# Name of this point of presence, shown in the console and in logs.
POP_ID=pop1

# Wildcard certificate for *.<zone>, obtained with DNS-01 by any ACME client.
# Leave the two paths empty to run with a development certificate that
# browsers will reject — fine for a look around, useless for customers.
FRONTDOOR_CERT_DIR=/etc/rackops/certs
FRONTDOOR_CERT=/etc/rackops/certs/fullchain.pem
FRONTDOOR_KEY=/etc/rackops/certs/privkey.pem

# ---- Support email relay (optional) ----
# Sends password-reset mail on behalf of installs with no SMTP of their own.
# The relay returns 503 until SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=RackOps Support <support@rackops.in>
