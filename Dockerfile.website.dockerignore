# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.website.dockerignore
# Excludes files NOT needed for the React/Vite website build context.
# Auto-detected by Docker BuildKit when building:
#   docker build -f Dockerfile.website .
# ─────────────────────────────────────────────────────────────────────────────

# Git
.git
.gitignore
.github
.gitea

# Docs & metadata
README.md
CHANGELOG.md
LICENSE
docs/

# Dev files
*.md
*.log
*.env
*.env.*
.env.example

# Node (explicit paths — Dokploy's tar builder doesn't support globstars well)
node_modules
apps/*/node_modules
packages/*/node_modules
dist
apps/*/dist
packages/*/dist
.turbo
apps/*/.turbo
packages/*/.turbo
npm-debug.log*
yarn-error.log*

# Go — not needed in the website image
cmd/
internal/
go.mod
go.sum
bin/
*.exe
Dockerfile.backend
Dockerfile.backend.dockerignore

# OS generated
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Test artifacts
coverage/
test-results/
