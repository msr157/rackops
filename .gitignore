.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Logs
*.log
logs/
npm-debug.log*
yarn-error.log*

# Node
node_modules/
dist/
build/
.turbo/

# Go
bin/
*.exe

# Docker artifacts
*.tar

# Coverage / test
coverage/
test-results/
.nyc_output/
