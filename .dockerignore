# ─────────────────────────────────────────────
# .dockerignore — exclude from Docker build ctx
#
# NOTE: Per-Dockerfile .dockerignore files are also present:
#   Dockerfile.website.dockerignore   (excludes Go sources for website builds)
#   Dockerfile.backend.dockerignore   (excludes Node/TS sources for backend builds)
# Docker BuildKit uses those automatically when -f Dockerfile.X is specified.
# ─────────────────────────────────────────────

# Git
.git
.gitignore
.github
.gitea

# Docs & metadata
README.md
CHANGELOG.md
LICENSE
docs/

# Dev files
*.log
*.env
*.env.*
.env.example

# Node (explicit paths — Dokploy's tar builder doesn't support globstars)
node_modules
apps/*/node_modules
packages/*/node_modules
dist
apps/*/dist
packages/*/dist
.turbo
apps/*/.turbo
packages/*/.turbo
npm-debug.log*
yarn-error.log*

# OS generated
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Test artifacts
coverage/
test-results/
