# ─────────────────────────────────────────────
# .dockerignore — exclude from Docker build ctx
# ─────────────────────────────────────────────

# Git
.git
.gitignore
.github
.gitea

# Docs & metadata
README.md
LICENSE
docs/

# Dev files
*.md
*.log
*.env
*.env.*
.env.example

# Node (any depth — pnpm workspaces have nested node_modules)
node_modules
apps/*/node_modules
packages/*/node_modules
dist
apps/*/dist
packages/*/dist
.turbo
apps/*/.turbo
packages/*/.turbo
npm-debug.log*
yarn-error.log*

# Go (not needed in the website image)
cmd/
internal/
go.mod
go.sum
bin/
*.exe

# OS generated
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Test artifacts
coverage/
test-results/

