# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.backend.dockerignore
# Excludes files NOT needed for the Go backend build context.
# This file is auto-detected by Docker BuildKit when building:
#   docker build -f Dockerfile.backend .
# ─────────────────────────────────────────────────────────────────────────────

# Git metadata
.git
.gitignore
.github
.gitea

# Docs
README.md
CHANGELOG.md
LICENSE
docs/
*.md

# Node / JS — not needed for Go build
apps/
packages/
node_modules
pnpm-workspace.yaml
pnpm-lock.yaml
turbo.json
*.json
!go.mod
!go.sum

# Build artifacts
dist/
bin/
*.exe

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Test artifacts
coverage/
test-results/
