# ─────────────────────────────────────────────────────
# RackOps website — nginx-served static Vite build.
#
# Dokploy's "Frontend" application (rackops.in) builds this file from the
# repository root:
#
#   docker build -f Dockerfile.website .
#
# The canonical definition lives at apps/website/Dockerfile; this root copy
# exists because Dokploy resolves its Dockerfile path from the repo root and
# is configured against this filename. Keep the two in sync — or repoint
# Dokploy at apps/website/Dockerfile and delete this file.
# ─────────────────────────────────────────────────────

# ── Stage 1: build the static site (pnpm workspace) ──────────────────────────
FROM node:22-alpine AS builder

RUN corepack enable
WORKDIR /build

# Manifests first so the install layer caches across source changes.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json ./
COPY apps/website/package.json apps/website/
COPY packages/api/package.json packages/api/
COPY packages/tsconfig/package.json packages/tsconfig/

RUN pnpm install --frozen-lockfile --filter @rackops/website...

COPY packages/ ./packages/
COPY apps/website/ ./apps/website/

RUN pnpm --filter @rackops/website build

# ── Stage 2: production runtime (nginx on Alpine) ────────────────────────────
FROM nginx:1.27-alpine

LABEL maintainer="rackops"
LABEL org.opencontainers.image.title="rackops-website"
LABEL org.opencontainers.image.description="RackOps — The Infrastructure Operating System"
LABEL org.opencontainers.image.licenses="MIT"

RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /build/apps/website/dist/ /usr/share/nginx/html/
COPY --from=builder /build/apps/website/nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

# 127.0.0.1, not localhost: Alpine resolves localhost to ::1 first and nginx
# listens on IPv4 only, which would fail the check and surface as a 502.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1/health || exit 1
