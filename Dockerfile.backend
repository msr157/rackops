# ─────────────────────────────────────────────────────────────────────────────
# RackOps backend (control plane) — build from the monorepo root:
#   docker build -f Dockerfile.backend .
#
# Produces a minimal Alpine image running the rackops-lite binary on :8080.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: compile ─────────────────────────────────────────────────────────
FROM golang:1.23-alpine AS builder

# Install git (required by go mod download for some VCS deps)
RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /build

# Copy go workspace files first so the module download layer is cached
# independently of source changes.
COPY go.mod go.sum ./
RUN go mod download

# Copy Go source only (website / TS files are not needed for the Go build)
COPY cmd/    ./cmd/
COPY internal/ ./internal/

# Build the rackops-lite binary, statically linked with CGO disabled so it
# runs on a pure Alpine runtime with no libc requirement.
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w -extldflags=-static" \
    -o /rackops-lite ./cmd/rackops-lite

# ── Stage 2: minimal runtime ──────────────────────────────────────────────────
FROM alpine:3.20

# ca-certificates for outbound TLS (agents call back to us; we may call out too)
RUN apk add --no-cache ca-certificates curl tzdata

LABEL maintainer="rackops"
LABEL org.opencontainers.image.title="rackops-lite"
LABEL org.opencontainers.image.description="RackOps Lite — The Infrastructure Operating System control plane"
LABEL org.opencontainers.image.licenses="MIT"

# Copy the statically-linked binary
COPY --from=builder /rackops-lite /usr/local/bin/rackops-lite

# Runtime env vars — override in Dokploy / docker-compose:
#   DATABASE_URL  postgres://user:pass@host:5432/dbname?sslmode=disable
#   PORT          8080 (default)
ENV PORT=8080

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fs http://127.0.0.1:${PORT}/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/rackops-lite"]
CMD ["-port", "8080"]
